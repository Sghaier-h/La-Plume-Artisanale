/**
 * HR Employee Controller - Version avec relations
 */

import { registry } from '../../../src/core/Environment.js';
import { sendSuccess, sendError } from '../../../src/utils/error.helper.js';
import { getPaginationParams, buildPaginationResponse } from '../../../src/utils/pagination.helper.js';
import { loadOne2Many } from '../../../src/core/Relations.js';
import { getTableName, getIdField } from '../../../src/core/TableMapping.js';

export const getHREmployees = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const HREmployee = env.model('hr.employee');

    const { page, limit, search, active, department_id } = req.query;
    const { offset, pageSize } = getPaginationParams(page, limit);

    const domain = [];
    if (search) {
      domain.push(['name', 'like', search]);
    }
    if (active !== undefined) {
      domain.push(['active', '=', active === 'true']);
    }
    if (department_id) {
      domain.push(['department_id', '=', department_id]);
    }

    const loadRelations = req.query.loadRelations === 'true';
    
    const employees = await HREmployee.search(domain, {
      limit: pageSize,
      offset,
      order: 'name asc',
      loadRelations: loadRelations ? {
        many2one: true,
        one2many: [],
        many2oneFields: ['job_id', 'department_id']
      } : undefined
    });

    const total = await HREmployee.search(domain).then(r => r.length);

    return sendSuccess(res, {
      data: employees,
      pagination: buildPaginationResponse(page, pageSize, total)
    });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const getHREmployee = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const HREmployee = env.model('hr.employee');

    const loadRelations = req.query.loadRelations === 'true';
    
    const employees = await HREmployee.read([req.params.id], {
      loadRelations: loadRelations ? {
        many2one: true,
        one2many: [],
        many2oneFields: ['job_id', 'department_id']
      } : undefined
    });
    
    if (!employees || employees.length === 0) {
      return sendError(res, 'Employee not found', 404);
    }

    return sendSuccess(res, { data: employees[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const createHREmployee = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const HREmployee = env.model('hr.employee');

    const employee = await HREmployee.create(req.body);
    return sendSuccess(res, { data: employee }, 201);
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const updateHREmployee = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const HREmployee = env.model('hr.employee');

    await HREmployee.write([req.params.id], req.body);
    const employees = await HREmployee.read([req.params.id], {
      loadRelations: {
        many2one: true,
        one2many: [],
        many2oneFields: ['job_id', 'department_id']
      }
    });

    return sendSuccess(res, { data: employees[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const deleteHREmployee = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const HREmployee = env.model('hr.employee');

    await HREmployee.unlink([req.params.id]);
    return sendSuccess(res, { message: 'Employee deleted' });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export default {
  getHREmployees,
  getHREmployee,
  createHREmployee,
  updateHREmployee,
  deleteHREmployee
};
