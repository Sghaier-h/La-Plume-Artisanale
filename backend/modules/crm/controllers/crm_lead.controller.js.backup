/**
 * CRM Lead Controller
 */

import { registry } from '../../../src/core/Environment.js';
import { sendSuccess, sendError } from '../../../src/utils/error.helper.js';
import { getPaginationParams, buildPaginationResponse } from '../../../src/utils/pagination.helper.js';
import { loadOne2Many } from '../../../src/core/Relations.js';
import { getTableName, getIdField, mapField } from '../../../src/core/TableMapping.js';
import { pool } from '../../../src/utils/db.js';

export const getLeads = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const Lead = env.model('crm.lead');

    const { page, limit, search, state, type } = req.query;
    const { offset, pageSize } = getPaginationParams(page, limit);

    const domain = [];
    if (search) {
      domain.push(['name', 'like', search]);
    }
    if (state) {
      domain.push(['state', '=', state]);
    }
    if (type) {
      domain.push(['type', '=', type]);
    }

    const loadRelations = req.query.loadRelations === 'true';
    
    const leads = await Lead.search(domain, {
      limit: pageSize,
      offset,
      order: 'create_date desc',
      loadRelations: loadRelations ? {
        many2one: true,
        one2many: [],
        many2oneFields: ['partner_id', 'stage_id']
      } : undefined
    });

    const total = await Lead.search(domain).then(r => r.length);

    return sendSuccess(res, {
      data: leads,
      pagination: buildPaginationResponse(page, pageSize, total)
    });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const getLead = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const Lead = env.model('crm.lead');

    const loadRelations = req.query.loadRelations === 'true';
    
    const leads = await Lead.read([req.params.id], {
      loadRelations: loadRelations ? {
        many2one: true,
        one2many: [],
        many2oneFields: ['partner_id', 'stage_id']
      } : undefined
    });
    
    if (!leads || leads.length === 0) {
      return sendError(res, 'Lead not found', 404);
    }

    return sendSuccess(res, { data: leads[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const createLead = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const Lead = env.model('crm.lead');

    const lead = await Lead.create(req.body);
    return sendSuccess(res, { data: lead }, 201);
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const updateLead = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const Lead = env.model('crm.lead');

    await Lead.write([req.params.id], req.body);
    const leads = await Lead.read([req.params.id], {
      loadRelations: {
        many2one: true,
        one2many: [],
        many2oneFields: ['partner_id', 'stage_id']
      }
    });

    return sendSuccess(res, { data: leads[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const deleteLead = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const Lead = env.model('crm.lead');

    await Lead.unlink([req.params.id]);
    return sendSuccess(res, { message: 'Lead deleted' });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const convertToOpportunity = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const Lead = env.model('crm.lead');

    const lead = await Lead.convertToOpportunity(req.params.id, req.body);
    return sendSuccess(res, { data: lead[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};
