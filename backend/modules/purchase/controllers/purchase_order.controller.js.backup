/**
 * PurchaseOrder Controller
 */

import { registry } from '../../../src/core/Environment.js';
import { sendSuccess, sendError } from '../../../src/utils/error.helper.js';
import { getPaginationParams, buildPaginationResponse } from '../../../src/utils/pagination.helper.js';
import { loadOne2Many } from '../../../src/core/Relations.js';
import { getTableName, getIdField, mapField } from '../../../src/core/TableMapping.js';
import { pool } from '../../../src/utils/db.js';

export const getPurchaseOrders = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const PurchaseOrder = env.model('purchase.order');

    const { page, limit, search, state, partner_id } = req.query;
    const { offset, pageSize } = getPaginationParams(page, limit);

    const domain = [];
    if (search) {
      domain.push(['name', 'like', search]);
    }
    if (state) {
      domain.push(['state', '=', state]);
    }
    if (partner_id) {
      domain.push(['partner_id', '=', partner_id]);
    }

    const loadRelations = req.query.loadRelations === 'true';
    
    const orders = await PurchaseOrder.search(domain, {
      limit: pageSize,
      offset,
      order: 'date_order desc',
      loadRelations: loadRelations ? {
        many2one: true,
        one2many: ['order_line'],
        many2oneFields: ['partner_id']
      } : undefined
    });

    const total = await PurchaseOrder.search(domain).then(r => r.length);

    return sendSuccess(res, {
      data: orders,
      pagination: buildPaginationResponse(page, pageSize, total)
    });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const getPurchaseOrder = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const PurchaseOrder = env.model('purchase.order');

    const loadRelations = req.query.loadRelations === 'true';
    
    const orders = await PurchaseOrder.read([req.params.id], {
      loadRelations: loadRelations ? {
        many2one: true,
        one2many: ['order_line', 'picking_ids', 'invoice_ids'],
        many2oneFields: ['partner_id', 'currency_id']
      } : undefined
    });
    
    if (!orders || orders.length === 0) {
      return sendError(res, 'Purchase order not found', 404);
    }

    return sendSuccess(res, { data: orders[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const confirmPurchaseOrder = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const PurchaseOrder = env.model('purchase.order');

    await PurchaseOrder.action_confirm([req.params.id]);
    const order = await PurchaseOrder.read([req.params.id]);

    return sendSuccess(res, { data: order[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const cancelPurchaseOrder = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const PurchaseOrder = env.model('purchase.order');

    await PurchaseOrder.action_cancel([req.params.id]);
    const order = await PurchaseOrder.read([req.params.id]);

    return sendSuccess(res, { data: order[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

/**
 * GET /api/purchase/orders/:id/lines - Obtient les lignes d'une commande
 */
export const getPurchaseOrderLines = async (req, res) => {
  try {
    const lineTable = getTableName('purchase.order.line');
    const orderIdField = getIdField('purchase.order');
    const lineIdField = getIdField('purchase.order.line');
    const orderIdFieldInLine = mapField('purchase.order.line', 'order_id');
    
    const query = `
      SELECT 
        l.*,
        a.nom_article as product_name,
        a.reference as product_code
      FROM ${lineTable} l
      LEFT JOIN articles a ON l.product_id = a.id_article
      WHERE l.${orderIdFieldInLine} = $1
      ORDER BY l.${lineIdField} ASC
    `;
    
    const result = await pool.query(query, [req.params.id]);
    
    return sendSuccess(res, { data: result.rows });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export default {
  getPurchaseOrders,
  getPurchaseOrder,
  confirmPurchaseOrder,
  cancelPurchaseOrder,
  getPurchaseOrderLines
};
