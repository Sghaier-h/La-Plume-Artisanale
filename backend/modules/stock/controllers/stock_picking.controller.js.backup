/**
 * StockPicking Controller
 */

import { registry } from '../../../src/core/Environment.js';
import { sendSuccess, sendError } from '../../../src/utils/error.helper.js';
import { getPaginationParams, buildPaginationResponse } from '../../../src/utils/pagination.helper.js';
import { loadOne2Many } from '../../../src/core/Relations.js';
import { getTableName, getIdField, mapField } from '../../../src/core/TableMapping.js';
import { pool } from '../../../src/utils/db.js';

export const getStockPickings = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const StockPicking = env.model('stock.picking');

    const { page, limit, search, state, picking_type_id } = req.query;
    const { offset, pageSize } = getPaginationParams(page, limit);

    const domain = [];
    if (search) {
      domain.push(['name', 'like', search]);
    }
    if (state) {
      domain.push(['state', '=', state]);
    }
    if (picking_type_id) {
      domain.push(['picking_type_id', '=', picking_type_id]);
    }

    const loadRelations = req.query.loadRelations === 'true';
    
    const pickings = await StockPicking.search(domain, {
      limit: pageSize,
      offset,
      order: 'scheduled_date desc',
      loadRelations: loadRelations ? {
        many2one: true,
        one2many: ['move_ids'],
        many2oneFields: ['partner_id', 'sale_id', 'purchase_id']
      } : undefined
    });

    const total = await StockPicking.search(domain).then(r => r.length);

    return sendSuccess(res, {
      data: pickings,
      pagination: buildPaginationResponse(page, pageSize, total)
    });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const getStockPicking = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const StockPicking = env.model('stock.picking');

    const loadRelations = req.query.loadRelations === 'true';
    
    const pickings = await StockPicking.read([req.params.id], {
      loadRelations: loadRelations ? {
        many2one: true,
        one2many: ['move_ids'],
        many2oneFields: ['partner_id', 'sale_id', 'purchase_id', 'location_id', 'location_dest_id']
      } : undefined
    });
    
    if (!pickings || pickings.length === 0) {
      return sendError(res, 'Picking not found', 404);
    }

    return sendSuccess(res, { data: pickings[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const confirmStockPicking = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const StockPicking = env.model('stock.picking');

    await StockPicking.action_confirm([req.params.id]);
    const picking = await StockPicking.read([req.params.id]);

    return sendSuccess(res, { data: picking[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

