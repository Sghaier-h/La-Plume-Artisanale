export const getPickingMoves = async (req, res) => {
  try {
    const userId = req.user?.id;
    const { page, limit } = req.query;
    const { offset, pageSize } = getPaginationParams(page, limit);

    // Récupérer les mouvements de stock pour ce picking
    const movesQuery = `
      SELECT *
      FROM stock_move
      WHERE picking_id = $1
      ORDER BY sequence ASC
      LIMIT $2 OFFSET $3
    `;
    
    const countQuery = `SELECT COUNT(*) as total FROM stock_move WHERE picking_id = $1`;
    
    const [movesResult, countResult] = await Promise.all([
      pool.query(movesQuery, [req.params.id, pageSize, offset]),
      pool.query(countQuery, [req.params.id])
    ]);
    
    const total = parseInt(countResult.rows[0].total);
    
    return sendSuccess(res, {
      data: movesResult.rows,
      pagination: buildPaginationResponse(page, pageSize, total)
    });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export default {
  getStockPickings,
  getStockPicking,
  confirmStockPicking,
  assignStockPicking,
  doneStockPicking,
  getPickingMoves
};
