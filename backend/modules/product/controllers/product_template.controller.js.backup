/**
 * ProductTemplate Controller
 */

import { registry } from '../../../src/core/Environment.js';
import { sendSuccess, sendError } from '../../../src/utils/error.helper.js';
import { getPaginationParams, buildPaginationResponse } from '../../../src/utils/pagination.helper.js';
import { loadOne2Many } from '../../../src/core/Relations.js';
import { getTableName, getIdField } from '../../../src/core/TableMapping.js';
import { pool } from '../../../src/utils/db.js';

export const getProductTemplates = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const ProductTemplate = env.model('product.template');

    const { page, limit, search, categ_id, active } = req.query;
    const { offset, pageSize } = getPaginationParams(page, limit);

    const domain = [];
    if (search) {
      domain.push('|', ['name', 'like', search], ['default_code', 'like', search]);
    }
    if (categ_id) {
      domain.push(['categ_id', '=', categ_id]);
    }
    if (active !== undefined) {
      domain.push(['active', '=', active === 'true']);
    }

    const loadRelations = req.query.loadRelations === 'true';
    
    const products = await ProductTemplate.search(domain, {
      limit: pageSize,
      offset,
      order: 'name asc',
      loadRelations: loadRelations ? {
        many2one: true,
        one2many: ['sale_order_line_ids'],
        many2oneFields: ['categ_id']
      } : undefined
    });

    const total = await ProductTemplate.search(domain).then(r => r.length);

    return sendSuccess(res, {
      data: products,
      pagination: buildPaginationResponse(page, pageSize, total)
    });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const getProductTemplate = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const ProductTemplate = env.model('product.template');

    const loadRelations = req.query.loadRelations === 'true';
    
    const products = await ProductTemplate.read([req.params.id], {
      loadRelations: loadRelations ? {
        many2one: true,
        one2many: ['sale_order_line_ids', 'purchase_order_line_ids', 'stock_move_ids'],
        many2oneFields: ['categ_id']
      } : undefined
    });
    
    if (!products || products.length === 0) {
      return sendError(res, 'Product not found', 404);
    }

    return sendSuccess(res, { data: products[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const createProductTemplate = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const ProductTemplate = env.model('product.template');

    const product = await ProductTemplate.create(req.body);
    return sendSuccess(res, { data: product }, 201);
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const updateProductTemplate = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const ProductTemplate = env.model('product.template');

    await ProductTemplate.write([req.params.id], req.body);
    const products = await ProductTemplate.read([req.params.id], {
      loadRelations: {
        many2one: true,
        one2many: ['sale_order_line_ids'],
        many2oneFields: ['categ_id']
      }
    });

    return sendSuccess(res, { data: products[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const deleteProductTemplate = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const ProductTemplate = env.model('product.template');

    await ProductTemplate.unlink([req.params.id]);
    return sendSuccess(res, { message: 'Product deleted' });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const getProductStock = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const ProductTemplate = env.model('product.template');

    const product = await ProductTemplate.read([req.params.id]);
    if (!product || product.length === 0) {
      return sendError(res, 'Product not found', 404);
    }

    // Récupérer le stock du produit
    const tableName = getTableName('product.template');
    const idField = getIdField('product.template');
    
    const stockQuery = `
      SELECT 
        location_id,
        SUM(qty) as qty
      FROM stock_quant
      WHERE product_id = $1
      GROUP BY location_id
    `;
    
    const stockResult = await pool.query(stockQuery, [req.params.id]);
    
    return sendSuccess(res, { 
      product: product[0],
      stock: stockResult.rows 
    });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const getProductMovements = async (req, res) => {
  try {
    const userId = req.user?.id;
    const { page, limit } = req.query;
    const { offset, pageSize } = getPaginationParams(page, limit);

    // Récupérer les mouvements de stock pour ce produit
    const movementsQuery = `
      SELECT *
      FROM stock_move
      WHERE product_id = $1
      ORDER BY date DESC
      LIMIT $2 OFFSET $3
    `;
    
    const countQuery = `SELECT COUNT(*) as total FROM stock_move WHERE product_id = $1`;
    
    const [movementsResult, countResult] = await Promise.all([
      pool.query(movementsQuery, [req.params.id, pageSize, offset]),
      pool.query(countQuery, [req.params.id])
    ]);
    
    const total = parseInt(countResult.rows[0].total);
    
    return sendSuccess(res, {
      data: movementsResult.rows,
      pagination: buildPaginationResponse(page, pageSize, total)
    });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export default {
  getProductTemplates,
  getProductTemplate,
  createProductTemplate,
  updateProductTemplate,
  deleteProductTemplate,
  getProductStock,
  getProductMovements
};
