/**
 * MrpProduction Controller
 */

import { registry } from '../../../src/core/Environment.js';
import { sendSuccess, sendError } from '../../../src/utils/error.helper.js';
import { getPaginationParams, buildPaginationResponse } from '../../../src/utils/pagination.helper.js';
import { loadOne2Many } from '../../../src/core/Relations.js';
import { getTableName, getIdField, mapField } from '../../../src/core/TableMapping.js';
import { pool } from '../../../src/utils/db.js';

export const getMrpProductions = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const MrpProduction = env.model('mrp.production');

    const { page, limit, search, state, product_id } = req.query;
    const { offset, pageSize } = getPaginationParams(page, limit);

    const domain = [];
    if (search) {
      domain.push(['name', 'like', search]);
    }
    if (state) {
      domain.push(['state', '=', state]);
    }
    if (product_id) {
      domain.push(['product_id', '=', product_id]);
    }

    const loadRelations = req.query.loadRelations === 'true';
    
    const productions = await MrpProduction.search(domain, {
      limit: pageSize,
      offset,
      order: 'date_start desc',
      loadRelations: loadRelations ? {
        many2one: true,
        one2many: ['move_raw_ids', 'move_finished_ids'],
        many2oneFields: ['product_id', 'bom_id']
      } : undefined
    });

    const total = await MrpProduction.search(domain).then(r => r.length);

    return sendSuccess(res, {
      data: productions,
      pagination: buildPaginationResponse(page, pageSize, total)
    });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const getMrpProduction = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const MrpProduction = env.model('mrp.production');

    const loadRelations = req.query.loadRelations === 'true';
    
    const productions = await MrpProduction.read([req.params.id], {
      loadRelations: loadRelations ? {
        many2one: true,
        one2many: ['move_raw_ids', 'move_finished_ids'],
        many2oneFields: ['product_id', 'bom_id']
      } : undefined
    });
    
    if (!productions || productions.length === 0) {
      return sendError(res, 'Production order not found', 404);
    }

    return sendSuccess(res, { data: productions[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export const confirmMrpProduction = async (req, res) => {
  try {
    const userId = req.user?.id;
    const env = registry.createEnvironment(userId);
    const MrpProduction = env.model('mrp.production');

    await MrpProduction.action_confirm([req.params.id]);
    const productions = await MrpProduction.read([req.params.id], {
      loadRelations: {
        many2one: true,
        one2many: ['move_raw_ids', 'move_finished_ids'],
        many2oneFields: ['product_id']
      }
    });

    return sendSuccess(res, { data: productions[0] });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

