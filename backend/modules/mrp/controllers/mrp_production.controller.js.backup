/**
 * GET /api/mrp/productions/:id/moves - Obtient les mouvements d'une production
 */
export const getProductionMoves = async (req, res) => {
  try {
    const moveTable = getTableName('stock.move');
    const productionIdField = getIdField('mrp.production');
    const moveIdField = getIdField('stock.move');
    
    const query = `
      SELECT 
        m.*,
        a.nom_article as product_name,
        a.reference as product_code
      FROM ${moveTable} m
      LEFT JOIN articles a ON m.product_id = a.id_article
      WHERE (m.raw_material_production_id = $1 OR m.production_id = $1)
      ORDER BY m.date_mouvement DESC
    `;
    
    const result = await pool.query(query, [req.params.id]);
    
    return sendSuccess(res, { data: result.rows });
  } catch (error) {
    return sendError(res, error.message, 500);
  }
};

export default {
  getMrpProductions,
  getMrpProduction,
  confirmMrpProduction,
  startMrpProduction,
  doneMrpProduction,
  getProductionMoves
};
