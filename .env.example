# ==========================================================
# Configuration pour docker-compose
# Copier ce fichier en .env à la racine et remplir les valeurs
# ==========================================================

# Environnement
NODE_ENV=production
LOG_LEVEL=info

# Base de données (OVH CloudDB ou local)
DB_HOST=your-db-host.com
DB_PORT=5432
DB_NAME=ERP_La_Plume
DB_USER=your_user
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=change_this_to_a_random_long_string_at_least_32_chars
JWT_EXPIRE=24h

# Frontend URL (pour CORS)
FRONTEND_URL=http://localhost

# ==========================================================
# Variables backend uniquement (pas docker-compose)
# Ces valeurs vont dans backend/.env
# ==========================================================

# USE_MOCK_AUTH=false
# DEV_MOCK_PASSWORD=DevLocal2024!
# API_URL=http://localhost:5000
# TIMEMOTO_WEBHOOK_SECRET=

# ─── Google Drive (photos catalogue) ─────────────────────────
# Pour activer l'upload photos articles vers Google Drive (même dossier que le GAS)
# GOOGLE_DRIVE_ENABLED=true
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json
# GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id-here
#
# Setup :
# 1. Google Cloud Console → créer service account
# 2. Télécharger la clé JSON
# 3. Partager le dossier Drive avec l'email du service account
# 4. Copier l'ID du dossier depuis l'URL Drive
