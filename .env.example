# ==========================================================
# Configuration pour docker-compose
# Copier ce fichier en .env à la racine et remplir les valeurs
# ==========================================================

# Environnement
NODE_ENV=production
LOG_LEVEL=info

# Base de données (OVH CloudDB ou local)
DB_HOST=your-db-host.com
DB_PORT=5432
DB_NAME=ERP_La_Plume
DB_USER=your_user
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=change_this_to_a_random_long_string_at_least_32_chars
JWT_EXPIRE=24h

# Frontend URL (pour CORS)
FRONTEND_URL=http://localhost

# ==========================================================
# Variables backend uniquement (pas docker-compose)
# Ces valeurs vont dans backend/.env
# ==========================================================

# USE_MOCK_AUTH=false
# DEV_MOCK_PASSWORD=DevLocal2024!
# API_URL=http://localhost:5000
# TIMEMOTO_WEBHOOK_SECRET=
