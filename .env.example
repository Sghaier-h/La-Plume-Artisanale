# ============================================================
# La Plume Artisanale ERP — production environment template
# Copy to .env at repo root, then fill values. NEVER commit .env.
# ============================================================

# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info                        # debug | info | warn | error
PORT=5000                             # backend listen port (internal)

# ─── Database — OVH CloudDB PostgreSQL ──────────────────────
DB_HOST=your-db-host.ovh.net
DB_PORT=5432
DB_NAME=ERP_La_Plume
DB_USER=your_user
DB_PASSWORD=your_password_here
DB_SSL=true                           # OVH CloudDB requires SSL

# ─── Auth / sessions ────────────────────────────────────────
# Generate: `openssl rand -hex 48`
JWT_SECRET=change_me_to_random_64_hex_chars
JWT_EXPIRE=24h
SESSION_SECRET=change_me_to_another_random_string

# ─── URLs / CORS ────────────────────────────────────────────
FRONTEND_URL=https://fabrication.laplume-artisanale.tn
CORS_ORIGIN=https://fabrication.laplume-artisanale.tn

# ─── SMTP (transactional email) ─────────────────────────────
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=noreply@laplume-artisanale.tn
SMTP_PASSWORD=change_me
SMTP_FROM="La Plume Artisanale <noreply@laplume-artisanale.tn>"

# ─── WhatsApp (Cloud API or provider) ───────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v20.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_TOKEN=EAAG...your_permanent_token

# ─── AI provider (used by AI modules) ───────────────────────
AI_PROVIDER=anthropic                 # anthropic | openai | ollama
AI_API_KEY=sk-ant-...

# ─── Mobile push (Firebase Cloud Messaging) ─────────────────
FCM_SERVER_KEY=AAAA...your_fcm_server_key

# ─── Google Drive (photos catalogue — optional) ─────────────
GOOGLE_DRIVE_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=/app/secrets/service-account.json
GOOGLE_DRIVE_FOLDER_ID=

# ─── Backup ─────────────────────────────────────────────────
BACKUP_RETENTION=30                   # number of daily backups to keep

# ============================================================
# Frontend build-time variables (read by React at `npm run build`).
# For docker-compose, these are baked into the frontend image, so
# rebuild the frontend after changing them:
#   docker compose build frontend && docker compose up -d
# ============================================================
REACT_APP_API_URL=https://fabrication.laplume-artisanale.tn/api
REACT_APP_SOCKET_URL=https://fabrication.laplume-artisanale.tn
